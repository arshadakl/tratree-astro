---
interface Feature {
  title: string;
  description: string;
  iconSvg: string;
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;
---

<section
  class="section section-parallax-intro section-experience"
  data-theme-section="dark"
  data-bg-section="dark"
  data-scroll-section
>
  <div class="container">

    <div class="experience-header">
      <h5>The Tratree Experience</h5>
      <h2>Why Travel With Tratree</h2>
    </div>

    <div class="row grid exp-grid">
      {features.map((feature) => (
        <div class="col exp-card">
          <div class="exp-icon">
            <Fragment set:html={feature.iconSvg} />
          </div>
          <span class="exp-accent"></span>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
