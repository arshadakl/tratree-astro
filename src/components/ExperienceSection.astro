---
interface Feature {
  title: string;
  description: string;
  iconSvg: string;
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;
---

<section
  class="section section-parallax-intro section-experience"
  data-theme-section="dark"
  data-bg-section="dark"
  data-scroll-section
>
  <div class="container">

    <!-- Centred header -->
    <div class="text-center mb-[calc(var(--title-size)*0.8)]">
      <h5 class="opacity-50 mb-[0.8em]">The Tratree Experience</h5>
      <h2>Why Travel With Tratree</h2>
    </div>

    <!-- 3-col bordered grid (gap: 0 — borders are the dividers) -->
    <div
      class="grid grid-cols-3 border border-[var(--color-border)] rounded-[calc(var(--border-radius)*0.4)] overflow-hidden items-stretch max-[840px]:grid-cols-1"
      style="gap: 0;"
    >
      {features.map((feature, index) => (
        <div
          class={[
            'flex flex-col relative group transition-colors duration-[0.6s]',
            'hover:bg-[rgba(var(--color-light-rgb),0.05)]',
            index < features.length - 1
              ? 'border-r border-[var(--color-border)] max-[840px]:border-r-0 max-[840px]:border-b'
              : '',
          ].join(' ')}
          style="padding: calc(var(--row-gap) * 2.5) calc(var(--col-gap) * 1.5); background-color: rgba(var(--color-light-rgb), 0.02);"
        >
          <!-- Icon circle -->
          <div
            class="w-12 h-12 rounded-full border border-[var(--color-border)] flex items-center justify-center flex-shrink-0 transition-[border-color,background-color] duration-[0.4s] group-hover:border-[var(--color-light)] group-hover:bg-[rgba(var(--color-light-rgb),0.08)]"
            style="margin-bottom: calc(var(--row-gap) * 1.8);"
          >
            <Fragment set:html={feature.iconSvg} />
          </div>

          <!-- Accent line — slides in from left on hover -->
          <span
            class="block h-px bg-[var(--color-light)] origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-[0.6s] ease-[cubic-bezier(.75,0,.25,1)]"
            style="width: 2.5em; margin-bottom: calc(var(--row-gap) * 1.4);"
          ></span>

          <h3 class="font-normal uppercase tracking-[0.03em] mb-[0.75em]"
            style="font-size: calc(var(--title-size) * 0.22);">
            {feature.title}
          </h3>
          <p class="text-[0.85em] opacity-50 leading-[1.75]">{feature.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
