---
const whatsappUrl = `https://wa.me/919526936172?text=${encodeURIComponent("Hi Tratree, I'm interested in booking a trip!")}`;
---

<section
  class="section section-contact"
  data-theme-section="dark"
  data-bg-section="dark"
  data-scroll-section
>
  <div class="container">
    <div class="contact-inner">

      <h5 class="contact-eyebrow">Get In Touch</h5>

      <h2 class="contact-heading">
        Start your
        <em>journey</em><br />
        with us
      </h2>

      <div class="contact-divider"></div>

      <div class="contact-links">

        <a
          href="https://www.instagram.com/tratreeofficial"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-link"
        >
          <div class="contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </div>
          <span>Instagram</span>
        </a>

        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-link"
        >
          <div class="contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
          </div>
          <span>WhatsApp</span>
        </a>

        <a
          href="tel:+919526936172"
          class="contact-link"
        >
          <div class="contact-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.26h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6.09 6.09l1.06-.97a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <span>+91 9526936172</span>
        </a>

      </div>

    </div>
  </div>
</section>

<style>
.section-contact {
  padding: 8rem 0;
}

.contact-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.contact-eyebrow {
  color: #6b7280;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  margin-bottom: 1.5rem;
  font-family: var(--font-manrope, sans-serif);
}

.contact-heading {
  color: #E5F242;
  font-size: clamp(2.5rem, 6vw, 4rem);
  font-weight: 500;
  line-height: 1.1;
  text-transform: uppercase;
  margin-bottom: 2.5rem;
  font-family: var(--font-instrument-sans, sans-serif);
}

.contact-heading em {
  font-weight: 400;
  font-style: italic;
  text-transform: lowercase;
  font-family: var(--font-instrument-serif, serif);
}

.contact-divider {
  width: 4rem;
  height: 1px;
  background: rgba(255, 255, 255, 0.1);
  margin-bottom: 2.5rem;
}

.contact-links {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
}

@media (min-width: 768px) {
  .contact-links {
    flex-direction: row;
    justify-content: center;
    gap: 3rem;
  }
}

.contact-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: #d1d5db;
  text-decoration: none;
  transition: color 0.25s ease;
  font-family: var(--font-manrope, sans-serif);
}

.contact-link:hover {
  color: #ffffff;
}

.contact-link:hover .contact-icon {
  border-color: #E5F242;
  color: #E5F242;
}

.contact-icon {
  width: 3rem;
  height: 3rem;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.25s ease, color 0.25s ease;
  flex-shrink: 0;
}

.contact-link span {
  font-size: 0.9375rem;
}
</style>
