---
// Static — no props
---

<section
  class="section section-parallax-intro section-vacation"
  data-theme-section="dark"
  data-bg-section="dark"
  data-scroll-section
>
  <div class="container">
    <div
      class="grid items-center gap-[8vw] max-[840px]:grid-cols-1 max-[840px]:gap-[calc(var(--row-gap)*3)]"
      style="grid-template-columns: 1fr 1fr;"
    >

      <!-- Image mosaic: 2-col inner grid, tall image spans both rows -->
      <div class="grid grid-cols-2 gap-[calc(var(--col-gap)*0.6)] max-[540px]:grid-cols-1">

        <!-- Tall image -->
        <div class="row-span-2 overflow-hidden rounded-[calc(var(--border-radius)*0.35)] group max-[540px]:row-span-1">
          <figure class="w-full relative overflow-hidden" style="padding-top: 145%;">
            <picture
              class="absolute inset-0 transition-transform duration-[0.6s] ease-[cubic-bezier(.75,0,.25,1)] group-hover:scale-[1.04]"
              style="height: 115%; top: -10%;"
              data-scroll data-scroll-speed="-0.5"
            >
              <img class="lazy absolute inset-0 w-full h-full object-cover"
                alt="Mountain valley"
                src="https://images.pexels.com/photos/12167045/pexels-photo-12167045.jpeg?auto=compress&cs=tinysrgb&w=80"
                data-src="https://images.pexels.com/photos/12167045/pexels-photo-12167045.jpeg?auto=compress&cs=tinysrgb&w=700" />
            </picture>
          </figure>
        </div>

        <!-- Short image 1 -->
        <div class="overflow-hidden rounded-[calc(var(--border-radius)*0.35)] group">
          <figure class="w-full relative overflow-hidden" style="padding-top: 90%;">
            <picture
              class="absolute inset-0 transition-transform duration-[0.6s] ease-[cubic-bezier(.75,0,.25,1)] group-hover:scale-[1.04]"
              style="height: 115%; top: -10%;"
              data-scroll data-scroll-speed="-0.5"
            >
              <img class="lazy absolute inset-0 w-full h-full object-cover"
                alt="Waterfall cave"
                src="https://images.pexels.com/photos/32584961/pexels-photo-32584961.jpeg?auto=compress&cs=tinysrgb&w=80"
                data-src="https://images.pexels.com/photos/32584961/pexels-photo-32584961.jpeg?auto=compress&cs=tinysrgb&w=700" />
            </picture>
          </figure>
        </div>

        <!-- Short image 2 -->
        <div class="overflow-hidden rounded-[calc(var(--border-radius)*0.35)] group">
          <figure class="w-full relative overflow-hidden" style="padding-top: 90%;">
            <picture
              class="absolute inset-0 transition-transform duration-[0.6s] ease-[cubic-bezier(.75,0,.25,1)] group-hover:scale-[1.04]"
              style="height: 115%; top: -10%;"
              data-scroll data-scroll-speed="-0.5"
            >
              <img class="lazy absolute inset-0 w-full h-full object-cover"
                alt="Road through forest"
                src="https://images.pexels.com/photos/34021102/pexels-photo-34021102.jpeg?auto=compress&cs=tinysrgb&w=80"
                data-src="https://images.pexels.com/photos/34021102/pexels-photo-34021102.jpeg?auto=compress&cs=tinysrgb&w=700" />
            </picture>
          </figure>
        </div>

      </div>

      <!-- Text column -->
      <div class="flex flex-col gap-[var(--row-gap)]">
        <h5 class="opacity-45">Curated Experiences</h5>
        <h2 class="leading-[1.1]">
          What makes a vacation
          <em style="font-family: 'Fraunces', sans-serif; font-style: italic; font-size: 0.95em; text-transform: none;">perfect</em>
          for you
        </h2>
        <div class="w-12 h-px bg-[var(--color-light)] opacity-40"></div>
        <p class="big opacity-50 leading-[1.8] max-w-[36em]">
          Whether you are planning a family getaway, a relaxing weekend escape, or an
          adventurous excursion, Tratree finds the perfect fit. From charming mountain
          cabins to lakeside lodges, every stay is handpicked for you.
        </p>
        <a
          href="#"
          class="self-start flex items-center justify-center px-8 bg-[var(--color-light)] text-[var(--color-dark)] text-[0.75em] uppercase tracking-[0.05em] font-medium transition-[opacity,transform] duration-[0.4s] ease-[cubic-bezier(.75,0,.25,1)] hover:opacity-85 hover:-translate-y-0.5"
          style="height: var(--btn-height); border-radius: var(--border-radius);"
        >
          Book Now
        </a>
      </div>

    </div>
  </div>
</section>
