---
// Static — no props
---

<section
  class="section section-parallax-intro section-vacation"
  data-theme-section="dark"
  data-bg-section="dark"
  data-scroll-section
>
  <div class="container">
    <div class="row grid vacation-grid">

      <div class="col vacation-mosaic">
        <div class="vacation-img tall">
          <figure>
            <picture class="overlay" data-scroll data-scroll-speed="-0.5">
              <img class="lazy overlay" alt="Mountain valley"
                src="https://images.pexels.com/photos/12167045/pexels-photo-12167045.jpeg?auto=compress&cs=tinysrgb&w=80"
                data-src="https://images.pexels.com/photos/12167045/pexels-photo-12167045.jpeg?auto=compress&cs=tinysrgb&w=700" />
            </picture>
          </figure>
        </div>
        <div class="vacation-img short">
          <figure>
            <picture class="overlay" data-scroll data-scroll-speed="-0.5">
              <img class="lazy overlay" alt="Waterfall cave"
                src="https://images.pexels.com/photos/32584961/pexels-photo-32584961.jpeg?auto=compress&cs=tinysrgb&w=80"
                data-src="https://images.pexels.com/photos/32584961/pexels-photo-32584961.jpeg?auto=compress&cs=tinysrgb&w=700" />
            </picture>
          </figure>
        </div>
        <div class="vacation-img short">
          <figure>
            <picture class="overlay" data-scroll data-scroll-speed="-0.5">
              <img class="lazy overlay" alt="Road through forest"
                src="https://images.pexels.com/photos/34021102/pexels-photo-34021102.jpeg?auto=compress&cs=tinysrgb&w=80"
                data-src="https://images.pexels.com/photos/34021102/pexels-photo-34021102.jpeg?auto=compress&cs=tinysrgb&w=700" />
            </picture>
          </figure>
        </div>
      </div>

      <div class="col vacation-text">
        <h5>Curated Experiences</h5>
        <h2>What makes a vacation <em>perfect</em> for you</h2>
        <div class="vacation-divider"></div>
        <p class="big">Whether you are planning a family getaway, a relaxing weekend escape,
          or an adventurous excursion, Tratree finds the perfect fit. From charming mountain
          cabins to lakeside lodges, every stay is handpicked for you.</p>
        <a
          href={`https://wa.me/919526936172?text=${encodeURIComponent("Hi Tratree, I'm interested in booking a trip!")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="t-btn"
        >Book Now</a>
      </div>

    </div>
  </div>
</section>
