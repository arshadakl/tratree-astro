---
interface Destination {
  title: string;
  tag: string;
  description: string;
  imageSrc: string;
  imageThumb: string;
  imageAlt: string;
}

interface Props {
  destinations: Destination[];
}

const { destinations } = Astro.props;
---

<section
  class="section-parallax-intro section-wonders"
  style="margin-bottom: 0; padding-bottom: 0;"
  data-theme-section="dark"
>
  <div
    class="section section-parallax-intro section-wonders"
    data-theme-section="dark"
    data-bg-section="dark"
    data-scroll-section
  >
    <div class="container">

      <!-- Section header -->
      <div class="flex items-end justify-between gap-[var(--col-gap)] mb-[calc(var(--row-gap)*2)] max-[540px]:flex-col max-[540px]:items-start">
        <div>
          <h5>Destinations</h5>
          <h2 class="max-w-[calc(var(--title-size)*4)]">Explore the Wonders<br />of the World</h2>
        </div>
        <div class="flex items-center gap-[var(--col-gap)]">
          <p class="max-w-[22em] text-right opacity-45 text-[0.9em] leading-[1.65] max-[540px]:text-left">
            We seek to bring you the most authentic travel experiences from around the globe.
          </p>
          <!-- Arrow button -->
          <div class="flex items-center justify-center w-10 h-10 rounded-full border border-[var(--color-border)] flex-shrink-0 cursor-pointer transition-[background-color,border-color] duration-[0.4s] hover:bg-[var(--color-light)] hover:border-[var(--color-light)] group">
            <svg class="w-[45%]" viewBox="0 0 24 24" fill="none">
              <line x1="5" y1="12" x2="19" y2="12"
                class="stroke-[var(--color-light)] group-hover:stroke-[var(--color-dark)] transition-colors duration-[0.4s]"
                stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <polyline points="12 5 19 12 12 19"
                class="stroke-[var(--color-light)] group-hover:stroke-[var(--color-dark)] transition-colors duration-[0.4s]"
                stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
        </div>
      </div>

      <!-- 4-col card grid -->
      <div class="grid grid-cols-4 gap-[var(--col-gap)] items-stretch max-[1024px]:grid-cols-2 max-[540px]:grid-cols-1">
        {destinations.map((dest) => (
          <div class="relative overflow-hidden rounded-[calc(var(--border-radius)*0.4)] group cursor-pointer">

            <!-- Aspect-ratio figure -->
            <figure class="w-full relative overflow-hidden" style="padding-top: 130%;">
              <picture
                class="absolute inset-0 transition-transform duration-[0.6s] ease-[cubic-bezier(.75,0,.25,1)] group-hover:scale-[1.04]"
                style="height: 115%; top: -10%;"
                data-scroll
                data-scroll-speed="-0.5"
              >
                <img
                  class="lazy absolute inset-0 w-full h-full object-cover"
                  alt={dest.imageAlt}
                  src={dest.imageThumb}
                  data-src={dest.imageSrc}
                />
              </picture>
            </figure>

            <!-- Gradient fade overlay -->
            <div
              class="absolute bottom-0 left-0 w-full h-[70%] pointer-events-none"
              style="background: linear-gradient(to top, rgba(var(--color-dark-rgb), 0.92) 0%, rgba(var(--color-dark-rgb), 0.55) 40%, rgba(var(--color-dark-rgb), 0.15) 70%, transparent 100%);"
            ></div>

            <!-- Card info -->
            <div class="absolute bottom-0 left-0 right-0" style="padding: calc(var(--row-gap) * 1.2);">
              <span class="inline-block text-[0.6em] uppercase tracking-[2px] text-[var(--color-dark)] bg-[var(--color-light)] px-[0.7em] py-[0.25em] rounded-[2em] mb-[0.6em] font-medium">
                {dest.tag}
              </span>
              <h4 class="text-[0.85em] text-[var(--color-light)] mb-[0.3em] font-normal uppercase tracking-[0.03em]">
                {dest.title}
              </h4>
              <p class="text-[0.7em] opacity-55 leading-[1.5]">{dest.description}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
