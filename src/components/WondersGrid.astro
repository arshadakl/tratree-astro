---
interface Destination {
  title: string;
  tag: string;
  description: string;
  imageSrc: string;
  imageThumb: string;
  imageAlt: string;
}

interface Props {
  destinations: Destination[];
}

const { destinations } = Astro.props;
---

<section
  class="section section-parallax-intro section-wonders"
  data-theme-section="dark"
  data-bg-section="dark"
  data-scroll-section
>
    <div class="container">

      <div class="wonders-top">
        <div>
          <h5>Destinations</h5>
          <h2>Explore the Wonders<br />of the World</h2>
        </div>
        <div class="wonders-top-right">
          <p>We seek to bring you the most authentic travel experiences from around the globe.</p>
          <div class="wonders-arrow">
            <svg viewBox="0 0 24 24" fill="none">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </div>
        </div>
      </div>

      <div class="row grid wonders-grid">
        {destinations.map((dest) => (
          <div class="col wonder-card">
            <figure>
              <picture class="overlay" data-scroll data-scroll-speed="-0.5">
                <img
                  class="lazy overlay"
                  alt={dest.imageAlt}
                  src={dest.imageThumb}
                  data-src={dest.imageSrc}
                />
              </picture>
            </figure>
            <div class="card-fade"></div>
            <div class="card-info">
              <span class="card-tag">{dest.tag}</span>
              <h4>{dest.title}</h4>
              <p>{dest.description}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
</section>
